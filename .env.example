# Copy this file to .env at the repository root.
# npm server scripts load it; Docker Compose reads it for interpolation.

# HTTP and Socket.IO port when running with npm.
# Docker keeps the container port at 3000; use SERVER_PORT for the host.
PORT=3000
SERVER_PORT=3000

# Set to debug to include server lifecycle logs.
LOG_LEVEL=debug

# Opt in to /dev/realtime-tester. Restart the server after changing this.
ENABLE_REALTIME_TESTER=false
